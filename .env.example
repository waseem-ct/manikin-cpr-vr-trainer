# Copy this file to `.env` (git-ignored) and adjust. `.env` is bundled into the app as an asset.

# ── VR server ────────────────────────────────────────────────────────────────
# Base URL of the VR server API (no trailing slash) and the endpoint live CPR events are POSTed to.
VR_BASE_URL=https://manikinapi.trueformgames.com:5180/api
VR_EVENT_PATH=/VrEvent
# Seconds before a request to the VR server is treated as failed (and retried).
VR_REQUEST_TIMEOUT_SECONDS=5
# Seconds between "VR server" link-quality pings shown on the game screen.
VR_PING_INTERVAL_SECONDS=3

# ── Manikin (Bluetooth LE) ───────────────────────────────────────────────────
# GATT service / characteristic the CPR manikin streams its sensor data on.
BLE_SERVICE_UUID=C201
BLE_CHARACTERISTIC_UUID=483E
# Devices whose name contains this text are listed first and treated as manikins.
BLE_DEVICE_NAME_KEYWORD=CT
